# Resilient Scraper Configuration
# Настройки для надежного скрапинга с восстановлением после ошибок

# Основные параметры скрапинга (снижен параллелизм)
CITY=moskva
START_PAGE=1
PAGES=20000
MAX_ITEMS=2000
PARALLELISM=1
DEAL_TYPE=sale

# Задержки между запросами (увеличены для снижения капчи)
DELAY_MIN=5000ms
DELAY_MAX=12000ms
# Resilient параметры
MAX_RETRIES=10
BASE_RETRY_DELAY=2s
MAX_RETRY_DELAY=5m
CAPTCHA_COOLDOWN=20m
ERROR_THRESHOLD=10
PROTECTIVE_MODE_DELAY=30s
SESSION_RECOVERY_DELAY=2m

# Маскировка и обход блокировок
USER_AGENT_ROTATION=true
USE_REFERER=true

# Прокси (разделенные запятыми)
# PROXY_LIST=http://proxy1:port,http://proxy2:port,http://proxy3:port

