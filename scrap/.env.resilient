# Resilient Scraper Configuration
# Настройки для надежного скрапинга с восстановлением после ошибок

# Основные параметры скрапинга (снижен параллелизм)
CITY=moskva
START_PAGE=1
PAGES=20000
MAX_ITEMS=2000
PARALLELISM=1
DEAL_TYPE=sale

# Задержки между запросами (увеличены для снижения капчи)
